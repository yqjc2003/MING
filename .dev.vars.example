# 复制为 .dev.vars 后填入你自己的值（.dev.vars 已被 .gitignore 忽略）。
# 部署时用同名环境变量注入：
#   SITE_GITHUB="https://github.com/xxx/repo" \
#   SITE_BAIDU_ID="b80b7cc6dc04b7948b52dbf3cc2ccc10" npm run deploy

# 页脚 GitHub 图标链接（同时供「勘误」链接到 issues/new），留空则不显示
SITE_GITHUB=

# 百度统计站点 ID（hm.baidu.com/hm.js? 后的那串），留空则不加载统计脚本
SITE_BAIDU_ID=
