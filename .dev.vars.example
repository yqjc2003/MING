# 复制为 .dev.vars 后填入你自己的值（.dev.vars 已被 .gitignore 忽略）。
# 部署时用同名环境变量注入：
#   SITE_BEIAN="苏ICP备XXXXXXXX号-1" SITE_GITHUB="https://github.com/xxx/repo" \
#   SITE_BAIDU_ID="6364be20c46859cfd1c2cf79d536145b" npm run deploy

# 页脚备案号，留空则不显示
SITE_BEIAN=

# 页脚「源码仓库」链接，留空则不显示
SITE_GITHUB=

# 百度统计站点 ID（hm.baidu.com/hm.js? 后的那串），留空则不加载统计脚本
SITE_BAIDU_ID=
